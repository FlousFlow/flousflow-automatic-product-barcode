#. module: flousflow_stock_barcode
msgid "%(count)s barcode(s) were generated."
msgstr "تم توليد %(count)s باركود."

#. module: flousflow_stock_barcode
msgid "A barcode could not be generated after multiple attempts because generated values are already in use."
msgstr "تعذر توليد باركود بعد عدة محاولات لأن القيم المولّدة مستخدمة بالفعل."

#. module: flousflow_stock_barcode
msgid "Assign barcodes to existing products that have no barcode."
msgstr "تعيين باركودات للمنتجات الموجودة التي ليس لها باركود."

#. module: flousflow_stock_barcode
msgid "Automatic Product Barcode Configuration"
msgstr "إعداد باركود المنتج التلقائي"

#. module: flousflow_stock_barcode
msgid "Automatic Product Barcodes"
msgstr "باركودات المنتجات التلقائية"

#. module: flousflow_stock_barcode
msgid "Automatically assign a unique barcode when a new product variant is created."
msgstr "تعيين باركود فريد تلقائياً عند إنشاء متغير منتج جديد."

#. module: flousflow_stock_barcode
msgid "Barcode Format"
msgstr "صيغة الباركود"

#. module: flousflow_stock_barcode
msgid "Barcode Generation"
msgstr "توليد الباركود"

#. module: flousflow_stock_barcode
msgid "Barcode Preview"
msgstr "معاينة الباركود"

#. module: flousflow_stock_barcode
msgid "Barcode Sequence"
msgstr "تسلسل الباركود"

#. module: flousflow_stock_barcode
msgid "Cancel"
msgstr "إلغاء"

#. module: flousflow_stock_barcode
msgid "Company"
msgstr "الشركة"

#. module: flousflow_stock_barcode
msgid "EAN-13"
msgstr "EAN-13"

#. module: flousflow_stock_barcode
msgid "Enable Automatic Barcode Generation"
msgstr "تفعيل توليد الباركود تلقائياً"

#. module: flousflow_stock_barcode
msgid "Existing Barcode Policy"
msgstr "سياسة الباركودات الموجودة"

#. module: flousflow_stock_barcode
msgid "Existing Products"
msgstr "المنتجات الموجودة"

#. module: flousflow_stock_barcode
msgid "Existing product barcodes are never overwritten."
msgstr "لا تتم الكتابة فوق باركودات المنتجات الموجودة أبداً."

#. module: flousflow_stock_barcode
msgid "First number to be generated."
msgstr "أول رقم سيتم توليده."

#. module: flousflow_stock_barcode
msgid "Generate Barcodes"
msgstr "توليد الباركودات"

#. module: flousflow_stock_barcode
msgid "Generate Missing Barcodes"
msgstr "توليد الباركودات الناقصة"

#. module: flousflow_stock_barcode
msgid "Generate Product Barcodes"
msgstr "توليد باركودات المنتجات"

#. module: flousflow_stock_barcode
msgid "Include Archived Products"
msgstr "تضمين المنتجات المؤرشفة"

#. module: flousflow_stock_barcode
msgid "Include archived product variants when generating missing barcodes."
msgstr "تضمين متغيرات المنتجات المؤرشفة عند توليد الباركودات الناقصة."

#. module: flousflow_stock_barcode
msgid "Invalid EAN-13 configuration"
msgstr "إعداد EAN-13 غير صالح"

#. module: flousflow_stock_barcode
msgid "Keep Existing Barcodes"
msgstr "الاحتفاظ بالباركودات الموجودة"

#. module: flousflow_stock_barcode
msgid "No barcode configuration exists for this company. Configure it in Settings first."
msgstr "لا يوجد إعداد باركود لهذه الشركة. قم بإعداده في الإعدادات أولاً."

#. module: flousflow_stock_barcode
msgid "No barcode configuration found for %(company)s. Configure it in Settings first."
msgstr "لم يتم العثور على إعداد باركود لـ %(company)s. قم بإعداده في الإعدادات أولاً."

#. module: flousflow_stock_barcode
msgid "No selected product is missing a barcode."
msgstr "لا يوجد منتج محدّد ينقصه باركود."

#. module: flousflow_stock_barcode
msgid "Number of digits of the sequential part. Example: prefix 20 and 10 digits produce 200000000001."
msgstr "عدد خانات الجزء التسلسلي. مثال: بادئة 20 و10 خانات تنتج 200000000001."

#. module: flousflow_stock_barcode
msgid "Only one barcode configuration can exist per company."
msgstr "لا يمكن وجود أكثر من إعداد باركود واحد لكل شركة."

#. module: flousflow_stock_barcode
msgid "Optional prefix prepended to the generated number."
msgstr "بادئة اختيارية تُضاف قبل الرقم المولّد."

#. module: flousflow_stock_barcode
msgid "Optional prefix prepended to the generated number. Must contain digits only for EAN-13."
msgstr "بادئة اختيارية تُضاف قبل الرقم المولّد. يجب أن تحتوي على أرقام فقط لصيغة EAN-13."

#. module: flousflow_stock_barcode
msgid "Prefix"
msgstr "البادئة"

#. module: flousflow_stock_barcode
msgid "Prefix + Sequential Numeric"
msgstr "بادئة + تسلسل رقمي"

#. module: flousflow_stock_barcode
msgid "Product barcode sequence - %s"
msgstr "تسلسل باركود المنتج - %s"

#. module: flousflow_stock_barcode
msgid "Products Without Barcode"
msgstr "المنتجات بدون باركود"

#. module: flousflow_stock_barcode
msgid "Sequence Digits"
msgstr "خانات التسلسل"

#. module: flousflow_stock_barcode
msgid "Sequential Numeric"
msgstr "تسلسل رقمي"

#. module: flousflow_stock_barcode
msgid "Sequential Numeric, Prefix + Sequential Numeric, or EAN-13 (with checksum)."
msgstr "تسلسل رقمي، أو بادئة + تسلسل رقمي، أو EAN-13 (مع رقم تحقق)."

#. module: flousflow_stock_barcode
msgid "Starting Number"
msgstr "رقم البداية"

#. module: flousflow_stock_barcode
msgid "The barcode prefix must contain digits only for EAN-13."
msgstr "يجب أن تحتوي بادئة الباركود على أرقام فقط لصيغة EAN-13."

#. module: flousflow_stock_barcode
msgid "The selected configuration produces more than 13 EAN digits. For EAN-13, the prefix length plus the sequence length must equal 12 digits."
msgstr "الإعداد المحدد يُنتج أكثر من 13 خانة EAN. لصيغة EAN-13 يجب أن يساوي طول البادئة زائد طول التسلسل 12 خانة."

#. module: flousflow_stock_barcode
msgid "The sequence length must be at least 1 digit."
msgstr "يجب أن يكون طول التسلسل خانة واحدة على الأقل."

#. module: flousflow_stock_barcode
msgid "The starting number cannot be negative."
msgstr "لا يمكن أن يكون رقم البداية سالباً."

#. module: flousflow_stock_barcode
msgid "The starting number does not fit in the configured sequence length."
msgstr "رقم البداية لا يتسع لطول التسلسل المُعد."

#. module: flousflow_stock_barcode
msgid "Use Generate Missing Barcodes to assign barcodes to existing products."
msgstr "استخدم توليد الباركودات الناقصة لتعيين باركودات للمنتجات الموجودة."

#. module: flousflow_stock_barcode
msgid "Smart Lot Barcode Generation"
msgstr "توليد باركودات التشغيلات الذكية"

#. module: flousflow_stock_barcode
msgid "Enable Smart Lot Barcodes"
msgstr "تفعيل باركودات التشغيلات الذكية"

#. module: flousflow_stock_barcode
msgid "Assign a barcode automatically to every new lot or serial of a tracked product."
msgstr "تعيين باركود تلقائياً لكل تشغيلة أو رقم تسلسلي جديد لمنتج متتبع."

#. module: flousflow_stock_barcode
msgid "Generate for New Lots"
msgstr "التوليد للتشغيلات الجديدة"

#. module: flousflow_stock_barcode
msgid "Generate the Smart Lot Barcode automatically when the lot or serial is created."
msgstr "توليد باركود التشغيلة الذكي تلقائياً عند إنشاء التشغيلة أو الرقم التسلسلي."

#. module: flousflow_stock_barcode
msgid "Smart Lot barcodes use the same format, prefix and sequence as Product Barcodes."
msgstr "تستخدم باركودات التشغيلات الذكية نفس الصيغة والبادئة والتسلسل الخاص بباركودات المنتجات."

#. module: flousflow_stock_barcode
msgid "Smart Lot labels use the Product Barcode format and sequence."
msgstr "تستخدم ملصقات التشغيلات الذكية نفس صيغة وتسلسل باركودات المنتجات."

#. module: flousflow_stock_barcode
msgid "Smart Lot Barcode"
msgstr "باركود التشغيلة الذكي"

#. module: flousflow_stock_barcode
msgid "Use the same barcode format and sequence configured for Product Barcodes."
msgstr "استخدم نفس صيغة وتسلسل باركودات المنتجات المُعدّة في الإعدادات."

#. module: flousflow_stock_barcode
msgid "Generate for new Lots"
msgstr "التوليد للتشغيلات الجديدة"

#. module: flousflow_stock_barcode
msgid "Lot labels use the Product Barcode format and sequence."
msgstr "تستخدم ملصقات التشغيلات نفس صيغة وتسلسل باركود المنتج."

#. module: flousflow_stock_barcode
msgid "Create Lots and Print Barcodes"
msgstr "إنشاء التشغيلات وطباعة الباركودات"

#. module: flousflow_stock_barcode
msgid "Create Lots & Print Barcodes"
msgstr "إنشاء التشغيلات وطباعة الباركودات"

#. module: flousflow_stock_barcode
msgid "Redistribute Lots"
msgstr "إعادة توزيع التشغيلات"

#. module: flousflow_stock_barcode
msgid "Apply & Print Barcodes"
msgstr "تطبيق وطباعة الباركودات"

#. module: flousflow_stock_barcode
msgid "Manufacturer Lot/Batch (optional)"
msgstr "تشغيلة/دفعة المصنع (اختياري)"

#. module: flousflow_stock_barcode
msgid "Leave blank for automatic Lot"
msgstr "اتركه فارغًا لإنشاء التشغيلة تلقائيًا"

#. module: flousflow_stock_barcode
msgid "Leave blank to generate an internal Lot name from the product barcode or code."
msgstr "اتركه فارغاً لإنشاء اسم تشغيلة داخلي من باركود المنتج أو كوده."

#. module: flousflow_stock_barcode
msgid "Expiration Date"
msgstr "تاريخ الصلاحية"

#. module: flousflow_stock_barcode
msgid "Quantity"
msgstr "الكمية"

#. module: flousflow_stock_barcode
msgid "Generate Missing Smart Lot Barcodes"
msgstr "توليد باركودات التشغيلات الذكية الناقصة"

#. module: flousflow_stock_barcode
msgid "Generate"
msgstr "توليد"

#. module: flousflow_stock_barcode
msgid "Include archived"
msgstr "تضمين المؤرشف"

#. module: flousflow_stock_barcode
msgid "Print Smart Lot Barcode"
msgstr "طباعة باركود التشغيلة الذكي"

#. module: flousflow_stock_barcode
msgid "Print Lot Barcodes"
msgstr "طباعة باركودات التشغيلات"

#. module: flousflow_stock_barcode
msgid "Smart Lot Barcode Label"
msgstr "ملصق باركود التشغيلة الذكي"

#. module: flousflow_stock_barcode
msgid "Smart Lot 50x30 mm"
msgstr "تشغيلة ذكية 50×30 مم"

#. module: flousflow_stock_barcode
msgid "Lot:"
msgstr "التشغيلة:"

#. module: flousflow_stock_barcode
msgid "Expires:"
msgstr "تنتهي في:"

#. module: flousflow_stock_barcode
msgid "Enable Smart Lot Barcodes for this company first."
msgstr "فعّل باركودات التشغيلات الذكية لهذه الشركة أولًا."

#. module: flousflow_stock_barcode
msgid "Smart Lot Barcodes"
msgstr "باركودات التشغيلات الذكية"

#. module: flousflow_stock_barcode
msgid "Label quantity must be between 1 and 1000."
msgstr "يجب أن تكون كمية الملصقات بين 1 و1000."

#. module: flousflow_stock_barcode
msgid "Lots can only be created from incoming receipts."
msgstr "لا يمكن إنشاء التشغيلات إلا من الاستلامات الواردة."

#. module: flousflow_stock_barcode
msgid "Lots cannot be created on a completed or cancelled transfer."
msgstr "لا يمكن إنشاء التشغيلات في تحويل مكتمل أو ملغى."

#. module: flousflow_stock_barcode
msgid "Add at least one manufacturer Lot/Batch before continuing."
msgstr "أضف تشغيلة/دفعة مصنع واحدة على الأقل قبل المتابعة."

#. module: flousflow_stock_barcode
msgid "Every selected product must be a tracked product on this transfer."
msgstr "يجب أن يكون كل منتج محدد منتجًا متتبعًا في هذا التحويل."

#. module: flousflow_stock_barcode
msgid "Lot quantities must be greater than zero."
msgstr "يجب أن تكون كميات التشغيلات أكبر من صفر."

#. module: flousflow_stock_barcode
msgid "The same Lot/Batch cannot be repeated for one product."
msgstr "لا يمكن تكرار نفس التشغيلة/الدفعة للمنتج الواحد."

#. module: flousflow_stock_barcode
msgid "The total quantity for %(product)s must be %(available)s; you entered %(requested)s."
msgstr "يجب أن يساوي إجمالي كمية %(product)s مقدار %(available)s؛ وقد أدخلت %(requested)s."

#. module: flousflow_stock_barcode
msgid "Could not generate an internal Lot name for %s."
msgstr "تعذر إنشاء اسم تشغيلة داخلي للمنتج %s."

#. module: flousflow_stock_barcode
msgid "Lots can only be redistributed on incoming receipts."
msgstr "لا يمكن إعادة توزيع التشغيلات إلا في الاستلامات الواردة."

#. module: flousflow_stock_barcode
msgid "Lots cannot be redistributed on a completed or cancelled transfer."
msgstr "لا يمكن إعادة توزيع التشغيلات في تحويل مكتمل أو ملغى."

#. module: flousflow_stock_barcode
msgid "There are no assigned Lots to redistribute on this transfer."
msgstr "لا توجد تشغيلات مُسندة لإعادة توزيعها في هذا التحويل."

#. module: flousflow_stock_barcode
msgid "Lot %(lot)s already has a different expiration date."
msgstr "التشغيلة %(lot)s لها تاريخ صلاحية مختلف بالفعل."

#. module: flousflow_stock_barcode
msgid "Create Lots for an Incoming Transfer"
msgstr "إنشاء تشغيلات لاستلام وارد"

#. module: flousflow_stock_barcode
msgid "Smart Lot lookup is unavailable. The scan was rejected."
msgstr "تعذر البحث عن التشغيلة الذكية. تم رفض المسح."

#. module: flousflow_stock_barcode
msgid "The Smart Lot Barcode is unknown or belongs to another company."
msgstr "باركود التشغيلة الذكي غير معروف أو تابع لشركة أخرى."

#. module: flousflow_stock_barcode
msgid "The product for this Smart Lot is not available in this POS."
msgstr "منتج هذه التشغيلة الذكية غير متاح في نقطة البيع هذه."
