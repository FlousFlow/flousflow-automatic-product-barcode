<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_smart_lot_barcode" model="ir.ui.view">
        <field name="name">product.product.form.smart.lot.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_view_form_normalized"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='name']" position="after">
                <button name="action_print_lot_barcodes" type="object" string="Print Lot Barcodes"/>
            </xpath>
        </field>
    </record>
</odoo>
