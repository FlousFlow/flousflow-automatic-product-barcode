<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_smart_lot" model="ir.ui.view">
        <field name="name">res.config.settings.smart.lot.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="inside">
                <setting id="smart_lot_barcode" string="Smart Lot Barcode" help="Generate stable Code 128 identifiers for native Lots.">
                    <field name="smart_lot_enabled"/>
                    <field name="smart_lot_auto_generate" invisible="not smart_lot_enabled"/>
                    <field name="smart_lot_prefix" invisible="not smart_lot_enabled"/>
                    <field name="smart_lot_sequence_digits" invisible="not smart_lot_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
