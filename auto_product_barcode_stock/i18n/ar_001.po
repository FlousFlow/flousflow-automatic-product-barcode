msgstr "تعذر إنشاء اسم تشغيلة داخلي للمنتج %s."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:257
msgid "Lots can only be redistributed on incoming receipts."
msgstr "لا يمكن إعادة توزيع التشغيلات إلا في الاستلامات الواردة."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:259
msgid "Lots cannot be redistributed on a completed or cancelled transfer."
msgstr "لا يمكن إعادة توزيع التشغيلات في تحويل مكتمل أو ملغى."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:261
