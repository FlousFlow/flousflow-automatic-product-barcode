msgstr "يجب أن تكون كمية الملصقات بين 1 و1000."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:148
msgid "Lots can only be created from incoming receipts."
msgstr "لا يمكن إنشاء التشغيلات إلا من الاستلامات الواردة."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:150
msgid "Lots cannot be created on a completed or cancelled transfer."
msgstr "لا يمكن إنشاء التشغيلات في تحويل مكتمل أو ملغى."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:152
msgid "Add at least one manufacturer Lot/Batch before continuing."
msgstr "أضف تشغيلة/دفعة مصنع واحدة على الأقل قبل المتابعة."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:168
msgid "Every selected product must be a tracked product on this transfer."
msgstr "يجب أن يكون كل منتج محدد منتجًا متتبعًا في هذا التحويل."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:174
msgid "Lot quantities must be greater than zero."
msgstr "يجب أن تكون كميات التشغيلات أكبر من صفر."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:180
msgid "The same Lot/Batch cannot be repeated for one product."
msgstr "لا يمكن تكرار نفس التشغيلة/الدفعة للمنتج الواحد."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:186
msgid "The total quantity for %(product)s must be %(available)s; you entered %(requested)s."
msgstr "يجب أن يساوي إجمالي كمية %(product)s مقدار %(available)s؛ وقد أدخلت %(requested)s."

#. module: auto_product_barcode_stock
#. odoo-python
#: code:addons/auto_product_barcode_stock/wizard/smart_lot_wizard.py:140
